# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here

# Optional: Specific Guild ID for instant slash command updates in development.
# If omitted or left blank, commands will be registered globally.
GUILD_ID=

# Optional: Default target prop firm preset ('tradeify', 'lucid', 'apex', 'bulenox', 'generic')
DEFAULT_FIRM_PRESET=generic

# Environment Mode: 'development' or 'production'
NODE_ENV=development

